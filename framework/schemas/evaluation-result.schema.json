{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PM AI Normalized Skill Evaluation Result",
  "type": "object",
  "required": [
    "framework_version",
    "source",
    "skill",
    "benchmark_context",
    "generic_metrics",
    "domain_metrics",
    "certification"
  ],
  "properties": {
    "framework_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "source": {
      "type": "object",
      "required": ["provider", "evaluator_version"],
      "properties": {
        "provider": {"type": "string"},
        "evaluator_version": {"type": "string"},
        "report_type": {"type": "string"}
      },
      "additionalProperties": false
    },
    "skill": {
      "type": "object"
    },
    "benchmark_context": {
      "type": "object"
    },
    "generic_metrics": {
      "type": "object"
    },
    "skill_lift": {
      "type": "object"
    },
    "reliability": {
      "type": "object"
    },
    "domain_metrics": {
      "type": "object"
    },
    "findings": {
      "type": "array"
    },
    "certification": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
